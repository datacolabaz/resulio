FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.18.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
RUN CI=1 pnpm install --frozen-lockfile
COPY . .
# Baked into the browser bundle at build time; override per environment (e.g. staging) with a service variable.
ARG VITE_API_URL=https://api.resulio.co
ENV VITE_API_URL=$VITE_API_URL
ENV NODE_ENV=production
RUN pnpm build:frontend

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
COPY --from=build /app/dist/public ./dist/public
COPY --from=build /app/dist/frontend.js ./dist/frontend.js
USER node
EXPOSE 3000
CMD ["node", "dist/frontend.js"]
