# Database (MySQL 8). Apply migrations with `pnpm db:migrate`, optional demo data with `pnpm db:seed`.
DATABASE_URL=mysql://user:password@host:3306/resulio

# Session cookie signing key (at least 32 random characters).
SESSION_SECRET=replace-with-at-least-32-random-characters

# Google OAuth — required for "Google ilə daxil ol".
# Create a Web application client: https://console.cloud.google.com/apis/credentials
# Local authorised JavaScript origin: http://localhost:3000
# Local authorised redirect URI:     http://localhost:3000/api/auth/google/callback
# Production redirect URI:           https://<your-domain>/api/auth/google/callback
# (split deploy: https://api.resulio.co/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; leave empty locally so the callback is derived from the request host.
# Production split-deploy example: https://api.resulio.co/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# Two-service deployment, API service only: origin of the separate frontend (e.g. https://resulio.co).
# When set, the API redirects page URLs there and allows that origin for credentialed CORS.
# Empty = the API also serves the web app (single service).
FRONTEND_URL=
# Optional extra comma-separated browser origins allowed to call the API with cookies.
CORS_ALLOWED_ORIGINS=

# Frontend build only: API origin baked into the browser bundle. Empty = same origin.
# Split Railway deploy: set this on the service that builds the SPA (resulio.co):
#   VITE_API_URL=https://api.resulio.co
# Dockerfile.frontend already defaults to that. Google OAuth vars belong on resulio-api,
# NOT on the frontend service — the browser must call api.resulio.co to log in.
VITE_API_URL=

# Optional comma-separated emails allowed to register as TEACHER. Empty = anyone may.
TEACHER_EMAIL_ALLOWLIST=

# Demo login buttons are always off in production; set to 1 to hide them in development too.
DISABLE_DEMO_LOGIN=

# Optional LLM endpoint for AI question generation. AI features are disabled when empty.
MANUS_API_URL=
MANUS_API_KEY=

# Host
PORT=3000
NODE_ENV=production
