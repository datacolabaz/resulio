# Database (MySQL 8). The server applies pending migrations from drizzle/ on every start (see RAILWAY.md);
# `pnpm db:migrate` does the same by hand. Optional demo data with `pnpm db:seed`.
DATABASE_URL=mysql://user:password@host:3306/resulio
# 0 = do not migrate on startup.
AUTO_MIGRATE=
# Only for a database whose tables exist but that has no __drizzle_migrations history: tag of the newest
# migration already in it (e.g. 0014_add_share_event_downloaded). Remove after the first successful start.
AUTO_MIGRATE_BASELINE=

# Session cookie signing key (at least 32 random characters).
SESSION_SECRET=replace-with-at-least-32-random-characters

# Google OAuth — required for "Google ilə daxil ol".
# Create a Web application client: https://console.cloud.google.com/apis/credentials
# Local authorised JavaScript origin: http://localhost:3000
# Local authorised redirect URI:     http://localhost:3000/api/auth/google/callback
# Production redirect URI:           https://<your-domain>/api/auth/google/callback
# (split deploy: https://api.resulio.co/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; leave empty locally so the callback is derived from the request host.
# Production split-deploy example: https://api.resulio.co/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# Two-service deployment, API service only: origin of the separate frontend (e.g. https://resulio.co).
# When set, the API redirects page URLs there and allows that origin for credentialed CORS.
# Empty = the API also serves the web app (single service).
FRONTEND_URL=
# Optional extra comma-separated browser origins allowed to call the API with cookies.
CORS_ALLOWED_ORIGINS=
# Optional. Split deploy usually infers .resulio.co from FRONTEND_URL. Set to none to force host-only cookies.
COOKIE_DOMAIN=

# Frontend build only: API origin baked into the browser bundle. Empty = same origin.
# Split Railway deploy: set this on the service that builds the SPA (resulio.co):
#   VITE_API_URL=https://api.resulio.co
# Dockerfile.frontend already defaults to that. Google OAuth vars belong on resulio-api,
# NOT on the frontend service — the browser must call api.resulio.co to log in.
VITE_API_URL=

# Optional comma-separated emails allowed to register as TEACHER. Empty = anyone may.
TEACHER_EMAIL_ALLOWLIST=

# Demo login buttons are always off in production; set to 1 to hide them in development too.
DISABLE_DEMO_LOGIN=

# AI (question generation, submission pre-review): any OpenAI-compatible chat-completions provider.
# AI features are off until AI_API_KEY (or the MANUS_* pair below) is set. The URL may be given with
# or without /v1 — the app adds "/v1" only when the URL has no version segment.
#   OpenAI (key: https://platform.openai.com/api-keys)
#     AI_API_URL=https://api.openai.com/v1      (or leave empty: OpenAI is the default)
#     AI_MODEL=gpt-4o-mini                      (default when empty)
#   Google Gemini, has a free tier (key: https://aistudio.google.com/apikey)
#     AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     AI_MODEL=gemini-3.8-flash                 (default for this URL when empty)
#   Others: Groq https://api.groq.com/openai/v1, DeepSeek https://api.deepseek.com, OpenRouter https://openrouter.ai/api/v1
AI_API_URL=
AI_API_KEY=
AI_MODEL=
# Submission pre-review: "1" turns it off; model overrides AI_MODEL for reviews only; cap is per workspace per 24h (default 100).
AI_REVIEW_DISABLED=
AI_REVIEW_MODEL=
AI_REVIEW_DAILY_LIMIT=

# Syllabus import from a file or pasted text: "1" turns it off; model overrides QUESTION_IMPORT_MODEL /
# AI_MODEL for this import only; cap = model requests (one per part of a document) per workspace per 24h (default 30).
SYLLABUS_IMPORT_DISABLED=
SYLLABUS_IMPORT_MODEL=
SYLLABUS_IMPORT_DAILY_LIMIT=

# E-mail via Resend (https://resend.com/api-keys): "your grade is ready"/"updated" and the preliminary
# AI feedback to students. See docs/NOTIFICATIONS.md.
# Without RESEND_API_KEY e-mails are skipped. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Resulio <noreply@resulio.co>
# Origin for links in e-mails; empty = https://resulio.co
APP_PUBLIC_URL=
# Max e-mails per second this server sends (new-task notices to large groups); empty = 8.
EMAIL_MAX_PER_SECOND=

# Mobile push (off while empty). Only needed once a mobile app registers devices; see docs/NOTIFICATIONS.md.
# PUSH_PROVIDER=expo; EXPO_ACCESS_TOKEN only if "enhanced push security" is on in the Expo project.
PUSH_PROVIDER=
EXPO_ACCESS_TOKEN=

# Browser push + admin announcements (off while empty; the permission prompt still works). Set on the API
# service only. Generate: node scripts/generate-vapid-keys.mjs. Changing the keys drops existing subscriptions
# until each browser visits again.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:support@resulio.co

# Legacy Manus Forge proxy. Used by the unused Manus template helpers (server/storage.ts etc.), and as the
# AI endpoint only when AI_API_KEY is empty. Uploaded files do NOT need these: they are stored in MySQL.
MANUS_API_URL=
MANUS_API_KEY=

# Syllabus (structured learning) feature flag: comma-separated provider workspace ids, or * for all.
# Empty = off everywhere (it can also be turned on per workspace from the admin panel). See docs/SYLLABUS-ARCHITECTURE.md §16.
SYLLABUS_ENABLED_WORKSPACES=

# Host
PORT=3000
NODE_ENV=production
